<div class="sidebar-wrap overflow-hidden">
    <div class="sidebar height-full overflow-y-scroll overflow-x-hidden">
        <div class="header d-flex flex-column p-3 site-brand">
            <a class="brand-link no-underline" href="{{ site.baseurl }}/" title="{{ site.description }}">
                <img class="brand-mark" src="{{ site.baseurl }}/config/assets/images/Icons/icon-96x96.png" width="36" height="36" alt="">
                <span class="brand-name">{{ site.title }}</span>
                <span class="brand-discipline">Systems · Robotics · Mechatronics</span>
            </a>
            <form class="search pt-3" action="{{ site.baseurl }}/search.html" method="get" autocomplete="off">
                <input class="form-control input-block input-sm" type="text" name="q" placeholder="{{ __.search_docs | default: 'Search docs…' }}">
            </form>
        </div>
        <div class="toctree py-2" data-spy="affix" role="navigation" aria-label="main navigation">
            {% include templates/toctree.liquid %}
        </div>
    </div>
</div>



<style>
    .archive { list-style-type: none; margin: 0; padding: 0.5rem 0.75rem 2rem; }
    .archive ul { list-style-type: none; padding-left: 0; }
</style>




<div class="sidebar-wrap-2 overflow-hidden">
    <div class="sidebar-2 height-full overflow-y-scroll overflow-x-hidden">

        <div class="bouton"></div>

            <button id="toggle2" aria-label="Toggle2 menu" class="btn-octicon-2 m-0 text-white" type="button">
                <i class="fa fa-caret-left"></i>
            </button>

        </div>

    </div>

    <div class="archive overflow-y-scroll">
        <h1 class="archive-heading">Last news</h1>

        {%- assign sorted_pages = site_pages | sort: 'time' | reverse -%}
        {%- assign current_year = "" -%}
        {%- assign current_month = "" -%}
        {%- for page in sorted_pages -%}
            {%- if page.time -%}
                {%- capture page_year -%}
                    {{ page.time | date: "%Y" }}
                {%- endcapture -%}
                {%- capture page_month -%}
                    {{ page.time | date: "%B" }}
                {%- endcapture -%}
                {%- if page_year != current_year -%}
                    {%- unless forloop.first -%}
                        </ul>
                    {%- endunless -%}
                    <h2 class="year">{{ page_year }}</h2>
                    <ul class="months">
                        {%- assign current_year = page_year -%}
                        {%- assign current_month = "" -%}
                {%- endif -%}
                {%- if page_month != current_month -%}
                    <h3 class="month">{{ page_month }}</h3>
                    <ul class="articles">
                        {%- assign current_month = page_month -%}
                {%- endif -%}
                <li class="article">{{ page.time | date: "%B %d" }} - <a href="{{ page.url }}">{{ page.title }}</a></li>
            {%- else -%}
                {%- capture upcoming_articles -%}
                    {{ upcoming_articles }}
                    <li class="article"><a href="{{ page.url }}">{{ page.title }}</a></li>
                {%- endcapture -%}
            {%- endif -%}
        {%- endfor -%}

        </ul>

        {% comment %} {%- if upcoming_articles != "" -%}
            <h2 class="year">Upcoming Articles</h2>
            <ul class="articles">
                {{ upcoming_articles }}
            </ul>
        {%- endif -%} {% endcomment %}

    </div>

</div>
